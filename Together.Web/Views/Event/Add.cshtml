<body>
    <h1>add data</h1>
    <form method="post" enctype="multipart/form-data" asp-controller="Home" asp-action="Index">
        <table>
            <tr>
                <td>name</td>
                <td><input type="text" id="txtName" name="name" /></td>
            </tr>
            <tr>
                <td>coordinator</td>
                <td><input type="text" id="txtCoordinator" name="coordinator" /></td>
            </tr>
            <tr>
                <td>Place:</td>
                <td><input type="text" id="txtPlace" name="place" /></td>
            </tr>
            <tr>
                <td>Lat:</td>
                <td><input type="number" id="floatLat" step="0.01" name="lat" /></td>
            </tr>
            <tr>
                <td>Lng:</td>
                <td><input type="number" id="floatLng" step="0.01" name="lng" /></td>
            </tr>
            <tr>
                <td>Fee:</td>
                <td><input type="number" id="intFee" name="fee" /></td>
            </tr>
            <tr>
                <td></td>
                <td><input type="submit" value="submit" /></td>
            </tr>
        </table>
    </form>
    <script src="" async defer></script>
